# Default initramfs source — minimal, no userland.
#
# Mirrors Linux's usr/default_cpio_list: just enough nodes for the kernel
# to mount a root and panic cleanly on "no init found".  Real workloads
# override CONFIG_INITRAMFS_SOURCE.
#
# Format (matches gen_init_cpio):
#   dir   <path> <mode> <uid> <gid>
#   nod   <path> <mode> <uid> <gid> <c|b> <maj> <min>
#   file  <path> <hostsrc> <mode> <uid> <gid>
#   slink <path> <target> <mode> <uid> <gid>
# Lines starting with '#' are comments.  Blank lines are ignored.

dir   /dev          0755 0 0
nod   /dev/console  0600 0 0 c 5 1
nod   /dev/null     0666 0 0 c 1 3
nod   /dev/zero     0666 0 0 c 1 5
dir   /proc         0755 0 0
dir   /sys          0755 0 0
dir   /tmp          1777 0 0
dir   /sbin         0755 0 0
dir   /bin          0755 0 0
dir   /etc          0755 0 0
